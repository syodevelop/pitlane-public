{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pitlane-local",
  "main": "server/worker.ts",
  "compatibility_date": "2026-10-18",
  "workers_dev": false,
  "env": {
    "staging": {
      "name": "pitlane-staging",
      "workers_dev": false,
      "vars": {
        "ENVIRONMENT": "staging",
        "APP_ORIGIN": "https://staging.pitlane.invalid",
        "CHAIN_ID": "0",
      },
      "durable_objects": {
        "bindings": [{ "name": "PLAYERS", "class_name": "PlayerDO" }],
      },
    },
    "production": {
      "name": "pitlane-production",
      "workers_dev": false,
      "vars": {
        "ENVIRONMENT": "production",
        "APP_ORIGIN": "https://pitlane.invalid",
        "CHAIN_ID": "0",
      },
      "durable_objects": {
        "bindings": [{ "name": "PLAYERS", "class_name": "PlayerDO" }],
      },
    },
  },
  "vars": {
    "ENVIRONMENT": "local",
    "APP_ORIGIN": "http://127.0.0.1:5173",
    "CHAIN_ID": "4663",
  },
  "durable_objects": {
    "bindings": [{ "name": "PLAYERS", "class_name": "PlayerDO" }],
  },
  "d1_databases": [
    {
      "binding": "PROJECTIONS",
      "database_name": "pitlane-local-projections",
      "database_id": "00000000-0000-0000-0000-000000000006",
      "migrations_dir": "migrations",
      "remote": false,
    },
  ],
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["PlayerDO"] }],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
  },
}
