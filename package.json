{
  "name": "pitlane",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "admin:password": "node scripts/admin-password.mjs",
    "preview:predeploy": "node scripts/predeploy-preview.mjs",
    "test:predeploy": "node scripts/predeploy-audit.mjs && node scripts/whitelist-recovery-smoke.mjs",
    "crew:build": "node scripts/build-gus-model.mjs dash && node scripts/build-gus-model.mjs juno && node scripts/build-gus-preview.mjs dash && node scripts/build-gus-preview.mjs juno",
    "crew:check": "node scripts/review-gus-model.mjs dash && node scripts/review-gus-model.mjs juno",
    "model:build": "node scripts/build-gus-model.mjs && node scripts/build-gus-preview.mjs",
    "model:check": "node scripts/review-gus-model.mjs",
    "dev:local": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-local.ps1",
    "db:local": "wrangler d1 migrations apply PROJECTIONS --local",
    "test:authority": "node scripts/authority-smoke.mjs",
    "dev": "vite --host 127.0.0.1",
    "dev:api": "wrangler dev --ip 127.0.0.1 --port 8787",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src server shared packages tests vite.config.ts",
    "test:core": "vitest run tests/game.test.ts tests/protocol.test.ts tests/garage-core.test.ts tests/navigation.test.ts tests/migration.test.ts",
    "simulate:progression": "node scripts/simulate-progression.mjs",
    "test:e2e": "node scripts/browser-smoke.mjs",
    "test:pilot": "node scripts/browser-smoke.mjs --pilot",
    "test:loop": "node scripts/browser-smoke.mjs --loop",
    "test:development": "node scripts/browser-smoke.mjs --development",
    "test:navigation": "node scripts/browser-smoke.mjs --navigation",
    "test:workshop": "vitest run tests/workshop.test.ts tests/workshop-racing.test.ts tests/workshop-mechanic.test.ts tests/workshop-performance.test.ts tests/workshop-visual.test.ts tests/service-route.test.ts tests/fleet.test.ts tests/garage-camera.test.ts",
    "test:workshop-performance-browser": "node scripts/workshop-performance-smoke.mjs && node scripts/workshop-performance-mobile-smoke.mjs",
    "test:workshop-mechanic-browser": "node scripts/workshop-mechanic-smoke.mjs && node scripts/workshop-mechanic-mobile-smoke.mjs",
    "test:workshop-racing-browser": "node scripts/workshop-racing-smoke.mjs",
    "test:workshop-browser": "node scripts/workshop-smoke.mjs && node scripts/workshop-mobile-smoke.mjs",
    "test:gait": "node scripts/scene-gait-smoke.mjs",
    "test:race-view": "node scripts/race-monitor-smoke.mjs",
    "test:work-animation": "node scripts/work-animation-smoke.mjs",
    "test:stock-animation": "node scripts/stock-animation-smoke.mjs",
    "test:local-web": "node scripts/local-web-smoke.mjs",
    "test:docs": "node scripts/docs-faq-smoke.mjs",
    "test:docs-faq": "node scripts/docs-faq-smoke.mjs",
    "test:public-site": "node scripts/public-site-smoke.mjs",
    "test:play-entry": "node scripts/play-entry-smoke.mjs",
    "test:release-ui": "node scripts/release-ui-smoke.mjs",
    "test:release-environments": "node scripts/release-environments-smoke.mjs",
    "test:built-preview": "node scripts/built-preview-smoke.mjs",
    "test:local-recovery": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/local-recovery-smoke.ps1",
    "test:actors": "node scripts/scene-actors-smoke.mjs",
    "test:vehicles": "node scripts/vehicle-motion-smoke.mjs",
    "test:traffic": "node scripts/race-traffic-smoke.mjs",
    "test:cars": "node scripts/car-collection-smoke.mjs",
    "test:feedback": "node scripts/garage-feedback-smoke.mjs",
    "test:annex": "node scripts/annex-smoke.mjs",
    "test:annex-live": "node scripts/annex-live.mjs",
    "test:crew-view": "node scripts/crew-renderer-smoke.mjs && node scripts/crew-garage-view.mjs",
    "art:prepare": "node scripts/prepare-art.mjs",
    "art:environment": "node scripts/prepare-environment.mjs",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build",
    "build": "tsc --noEmit && vite build && vite build --ssr src/entry-server.tsx --outDir .tmp/site-ssr && node scripts/prerender-site.mjs",
    "test": "vitest run",
    "test:api": "node scripts/api-smoke.mjs",
    "test:auth-api": "node scripts/auth-api-smoke.mjs",
    "test:auth-browser": "node scripts/auth-browser-smoke.mjs",
    "test:external-wallet": "node scripts/external-wallet-smoke.mjs",
    "test:appkit": "node scripts/appkit-smoke.mjs && node scripts/appkit-smoke.mjs --mobile",
    "test:browser": "node scripts/browser-smoke.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 5173",
    "check:licenses": "node scripts/licenses.mjs",
    "test:workshop-account-browser": "node scripts/workshop-account-smoke.mjs"
  },
  "dependencies": {
    "@reown/appkit": "1.8.24",
    "@walletconnect/ethereum-provider": "2.23.7",
    "phaser": "3.90.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.180.0",
    "viem": "2.57.7"
  },
  "overrides": {
    "@walletconnect/ethereum-provider": {
      "@reown/appkit": "$@reown/appkit"
    }
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261018.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.180.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.5",
    "wrangler": "4.151.1"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "description": "Pitlane: a browser-based 3D garage tycoon with wallet sign-in and persistent workshop progression.",
  "repository": {
    "type": "git",
    "url": "https://github.com/syodevelop/pitlane-public.git"
  },
  "homepage": "https://pitlane.one"
}
